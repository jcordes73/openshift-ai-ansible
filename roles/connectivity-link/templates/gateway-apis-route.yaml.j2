apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: apis
  namespace: gateway-system
spec:
  host: apis.{{ openshift_apps_domain }}
  to:
    kind: Service
    name: apis-openshift-default
    weight: 100
  port:
    targetPort: https 
  tls:
    termination: passthrough
    insecureEdgeTerminationPolicy: Redirect
  wildcardPolicy: None

