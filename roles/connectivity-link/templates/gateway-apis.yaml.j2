apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: apis
  namespace: gateway-system
  labels:
    kuadrant.io/gateway: "true"
spec:
  gatewayClassName: openshift-default
  infrastructure:
    parametersRef:
      group: ""
      kind: ConfigMap
      name: apis-gw-options
  listeners:
    - allowedRoutes:
        namespaces:
          from: All
      hostname: "apis.{{ base_domain }}"
      name: api
      port: 443
      protocol: HTTPS
      tls:
        certificateRefs:
        - group: ""
          kind: Secret
          name: api-gateway-service-tls
        mode: Terminate
