apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: maas
  namespace: openshift-ingress
  annotations:
    route.openshift.io/termination: "reencrypt" 
    route.openshift.io/destination-ca-certificate-secret: maas-gateway-service-tls 
spec:
  rules:
  - host: maas.{{ openshift_apps_domain }} 
    http:
      paths:
      - backend:
          service:
            name: maas-default-gateway-data-science-gateway-class
            port:
              number: 443
        path: /
        pathType: Prefix
